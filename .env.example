# =============================================================================
# Sao chép file này thành .env rồi điền giá trị thật.
# TUYỆT ĐỐI không commit file .env lên Git.
# =============================================================================

# ─── SQL Server ──────────────────────────────────────────────────────────────
# Mật khẩu phải >= 8 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt.
MSSQL_SA_PASSWORD=ToanTuDuy@2026
MSSQL_PID=Developer
DB_NAME=ToanTuDuyDb
SQLSERVER_PORT=1433

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ─── Backend .NET ────────────────────────────────────────────────────────────
BACKEND_PORT=5114
ASPNETCORE_ENVIRONMENT=Production
# Phải >= 32 byte. Đổi giá trị này trước khi triển khai thật.
JWT_KEY="Chuoi_Bi_Mat_Dai_Va_Phuc_Tap_Nhat_Co_The_123!@#"
JWT_ISSUER=ToanTuDuy
JWT_AUDIENCE=ToanTuDuyClient
# URL công khai của web, dùng cho link xác minh email / đặt lại mật khẩu
PUBLIC_WEB_URL=http://localhost:8080
PASSWORD_RESET_FROM_EMAIL=onboarding@resend.dev
RESEND_API_TOKEN=

# ─── Web Frontend ────────────────────────────────────────────────────────────
WEB_PORT=8080
# URL backend mà TRÌNH DUYỆT gọi tới (không phải tên service trong Docker).
# Giá trị được nhúng vào bundle lúc build => đổi thì phải build lại web.
VITE_API_BASE_URL=http://localhost:5114
VITE_IMPORT_WORKER_URL=

# ─── AI RAG service ──────────────────────────────────────────────────────────
AI_PORT=8001
AI_LLM_PROVIDER=groq
AI_LLM_BASE_URL=https://api.groq.com/openai/v1
AI_LLM_API_KEY=
AI_LLM_CHAT_MODEL=openai/gpt-oss-120b
AI_LLM_SUMMARY_MODEL=openai/gpt-oss-20b
AI_LLM_FALLBACK_ENABLED=false
AI_EMBEDDING_PROVIDER=nomic
AI_NOMIC_API_KEY=
AI_NOMIC_BASE_URL=https://api-atlas.nomic.ai/v1
AI_NOMIC_EMBEDDING_MODEL=nomic-embed-text-v1.5
AI_CORS_ORIGINS=*
# Khi dùng Ollama chạy trên máy host:
OLLAMA_BASE_URL=http://host.docker.internal:11434
