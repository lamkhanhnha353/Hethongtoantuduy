# =============================================================================
# FILE CẤU HÌNH MẪU (.env.example) - HỆ THỐNG TOÁN TƯ DUY
# Sao chép file này thành .env rồi điền giá trị thật.
# TUYỆT ĐỐI không commit file .env lên Git.
# =============================================================================

# ─── 1. SQL Server 2022 ──────────────────────────────────────────────────────
# Mật khẩu SA phải >= 8 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt
MSSQL_SA_PASSWORD=ToanTuDuy@2026
MSSQL_PID=Developer
DB_NAME=ToanTuDuyDb
SQLSERVER_PORT=1433

# ─── 2. Redis ────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ─── 3. Backend ASP.NET Core Web API ─────────────────────────────────────────
BACKEND_PORT=5114
ASPNETCORE_ENVIRONMENT=Production
# Khóa JWT (tối thiểu 32 ký tự, dùng chung giữa Backend và AI Service)
JWT_KEY="Chuoi_Bi_Mat_Dai_Va_Phuc_Tap_Nhat_Co_The_123!@#"
JWT_ISSUER=ToanTuDuy
JWT_AUDIENCE=ToanTuDuyClient

# URL công khai của Frontend (dùng cho link xác minh email / đặt lại mật khẩu)
PUBLIC_WEB_URL=http://localhost:8080

# Cấu hình gửi mail (Resend)
PASSWORD_RESET_FROM_EMAIL=onboarding@resend.dev
RESEND_API_TOKEN=

# ─── 4. Tích hợp bên thứ ba (Third-party Backend Services) ───────────────────
# Cloudinary (Lưu trữ ảnh / media)
CLOUDINARY_CLOUD_NAME=dzmtjui5d
CLOUDINARY_API_KEY=622845256911255
CLOUDINARY_API_SECRET=jajjo9MJxZsCoitM2EqejvSphHI

# Google OAuth Client
GOOGLE_CLIENT_ID=960166964291-v31v0cr8hc5gsj50jvvenhvo6r9le1rv.apps.googleusercontent.com

# Cổng thanh toán VNPAY (Tùy chọn)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_BASE_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/payment/callback
VNPAY_IPN_URL=http://localhost:5114/api/payment/vnpay-ipn
VNPAY_MOBILE_DEEP_LINK=

# ─── 5. Web Frontend (Vue 3 + Vite + Nginx) ──────────────────────────────────
WEB_PORT=8080
# URL API Backend mà trình duyệt truy cập tới (nhúng vào bundle lúc build image)
VITE_API_BASE_URL=http://localhost:5114
# URL của Import Worker Service mà trình duyệt gọi tới
VITE_IMPORT_WORKER_URL=http://localhost:8000

# ─── 6. AI RAG Service (FastAPI) ─────────────────────────────────────────────
AI_PORT=8001
AI_LLM_PROVIDER=groq
AI_LLM_BASE_URL=https://api.groq.com/openai/v1
AI_LLM_API_KEY=
AI_LLM_CHAT_MODEL=openai/gpt-oss-120b
AI_LLM_SUMMARY_MODEL=openai/gpt-oss-20b
AI_LLM_FALLBACK_ENABLED=false
AI_EMBEDDING_PROVIDER=nomic
AI_NOMIC_API_KEY=
AI_NOMIC_BASE_URL=https://api-atlas.nomic.ai/v1
AI_NOMIC_EMBEDDING_MODEL=nomic-embed-text-v1.5
AI_CORS_ORIGINS=*
# Khi dùng Ollama chạy cục bộ trên máy host:
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ─── 7. Question Import Worker (Python FastAPI Service) ───────────────────────
IMPORT_WORKER_PORT=8000
IMPORT_WORKER_BASE_URL=http://localhost:8000
IMPORT_WORKER_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEFAULT_BANK_ID=1
