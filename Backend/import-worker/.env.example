# Chọn "gemini" hoặc "openai" để gọi mô hình AI thật.
# Chọn "mock" chỉ để kiểm thử offline; mock không sử dụng AI.
LLM_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEYS=your_first_gemini_api_key,your_second_gemini_api_key
# GEMINI_API_KEY=your_legacy_single_key
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI API (Optional alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Server Settings
APP_HOST=0.0.0.0
APP_PORT=8000
BASE_URL=http://127.0.0.1:8000

# Batching & Request Optimization (Giảm số lượng request gọi LLM)
BATCH_SIZE=5
MAX_IMAGES_PER_BATCH=3
MAX_CONCURRENT_BATCHES=2

# Storage Directories
STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads
IMAGE_DIR=./storage/images

# Staging / API settings
DEFAULT_BANK_ID=1

python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
