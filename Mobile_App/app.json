{
  "expo": {
    "name": "Mobile_App",
    "slug": "Mobile_App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "toantuduy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.beckham205.Mobile_App"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ứng dụng cần quyền truy cập thư viện ảnh để chọn ảnh đại diện hoặc gửi ảnh trong tin nhắn.",
          "cameraPermission": "Ứng dụng cần quyền sử dụng máy ảnh để chụp và gửi ảnh trong tin nhắn.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "expo-video",
      "expo-asset",
      "expo-audio",
      "expo-image",
      [
        "expo-media-library",
        {
          "photosPermission": "Ứng dụng cần quyền lưu ảnh đã tải từ cuộc trò chuyện.",
          "savePhotosPermission": "Ứng dụng cần quyền lưu ảnh đã tải từ cuộc trò chuyện.",
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "05845a13-8f40-4f3b-946e-e4bd1011ce00"
      }
    }
  }
}
