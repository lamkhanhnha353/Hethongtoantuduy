# Server
APP_HOST=0.0.0.0
APP_PORT=8001

# JWT phải trùng Backend/ToanTuDuy/appsettings.json
JWT_SECRET_KEY="your_super_secret_key_here_at_least_32_bytes"
JWT_ALGORITHM=HS256
JWT_ISSUER=ToanTuDuy
JWT_AUDIENCE=ToanTuDuyClient

# LLM chat provider: ollama | groq | openai | gemini | openai_compatible
# Các biến LLM_* chỉ dùng khi LLM_PROVIDER khác ollama.
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_CHAT_MODEL=openai/gpt-oss-120b
LLM_SUMMARY_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=512
LLM_FALLBACK_ENABLED=false

# Embedding provider: ollama | nomic
# Groq không cung cấp embedding model; dùng nomic cho RAG.
EMBEDDING_PROVIDER=nomic
NOMIC_API_KEY=
NOMIC_BASE_URL=https://api-atlas.nomic.ai/v1
NOMIC_EMBEDDING_MODEL=nomic-embed-text-v1.5
NOMIC_EMBEDDING_DIMENSIONS=768
NOMIC_TIMEOUT_SECONDS=30
NOMIC_MAX_RETRIES=2

# Ollama: chat fallback + embedding khi EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b-instruct
OLLAMA_SUMMARY_MODEL=qwen2.5:3b-instruct
OLLAMA_CHAT_KEEP_ALIVE=5m
EMBEDDING_MODEL=nomic-embed-text
# Nomic task prefixes cho Ollama. Nomic API dùng task_type, không dùng prefix.
EMBEDDING_QUERY_PREFIX=search_query:
EMBEDDING_DOCUMENT_PREFIX=search_document:

# Storage
CHROMA_PERSIST_DIRECTORY=./storage/chroma
SQLITE_URL=sqlite:///./storage/app.db
DOCUMENTS_DIR=./storage/documents
MAX_DOCUMENT_FILE_SIZE_MB=20

# CORS: "*" hoặc danh sách phân tách bằng dấu phẩy
CORS_ORIGINS=*

# Tắt telemetry của ChromaDB
ANONYMIZED_TELEMETRY=False

# RAG
TOP_K=4
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Chat streaming
CHAT_MAX_PROMPT_CHARS=2000
CHAT_MAX_HISTORY_MESSAGES=20
CHAT_MAX_HISTORY_MESSAGE_CHARS=4000
CHAT_MAX_HISTORY_CHARS=12000
CHAT_NUM_PREDICT=512
CHAT_TEMPERATURE=0.3

# Conversation memory
CONTEXT_TOKEN_BUDGET=6000
RECENT_TURNS_TO_KEEP=10
MIN_RECENT_TURNS=2
TOKEN_ESTIMATE_CHARS_PER_TOKEN=3.0
MESSAGE_TOKEN_OVERHEAD=4
# Legacy alias, chỉ dùng khi OLLAMA_SUMMARY_MODEL trống.
SUMMARY_MODEL=qwen2.5:3b-instruct
SUMMARY_MAX_TOKENS=400
